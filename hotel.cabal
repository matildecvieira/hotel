cabal-version:      2.4
name:               hotel
version:            0.1.0.0
synopsis:           Sistema de Gestao de Hotel (projeto de Programacao Funcional)
build-type:         Simple

common comum
    default-language: Haskell2010
    ghc-options:      -Wall

library
    import:           comum
    hs-source-dirs:   src
    exposed-modules:  Model
                      Quartos
                      Reservas
                      Faturacao
                      DadosTeste
    build-depends:    base >=4 && <5

executable hotel
    import:           comum
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base >=4 && <5, hotel

test-suite hotel-test
    import:           comum
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:    base >=4 && <5, hotel
